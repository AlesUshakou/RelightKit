# RK_AreaLight by Aleš Ushakou (https://www.linkedin.com/in/ales-ushakou/)
Gizmo {
 name RK_AreaLight
 tile_color 0xcc66ffff
 inputs 1
 addUserKnob {20 light_control l "Light Control"}
 addUserKnob {26 title l "" +STARTLINE T "<b>RelightKit Area Light</b>\nScreen-anchored rectangular light with soft depth falloff.\nP built internally as (x/width, y/height, Depth) - no hard occlusion.\nInput: PBR packed stream (must contain a Depth layer)."}
 addUserKnob {18 lightColor l Color}
 lightColor {1 1 1}
 addUserKnob {6 lightColor_panelDropped l "panel dropped state" -STARTLINE +HIDDEN}
 addUserKnob {7 lightIntensity l Intensity R 0 10}
 lightIntensity 1
 addUserKnob {26 divider1 l "" +STARTLINE T "Placement"}
 addUserKnob {12 light_pos l "Anchor (screen)"}
 light_pos {0 0}
 addUserKnob {7 offset_z l "Offset Z (Depth)" R -1 1}
 offset_z 0
 addUserKnob {22 freeze_depth l "Freeze Depth" t "Sample the Depth under the Anchor handle and lock it so it stops recomputing." T "import nuke\n\nn = nuke.thisNode()\nx = n.knob('light_pos').value(0)\ny = n.knob('light_pos').value(1)\n\nv = None\ntry:\n    v = n.node('SDepth').sample('red', x, y)\nexcept Exception:\n    try:\n        v = n.input(0).sample('Depth.red', x, y)\n    except Exception:\n        v = None\n\nif v is not None:\n    n.knob('frozen_depth').setValue(float(v))\n    n.knob('use_frozen').setValue(True)\nelse:\n    nuke.message('Could not sample Depth under the handle.')" +STARTLINE}
 addUserKnob {6 use_frozen l "Use Frozen Depth" +STARTLINE}
 use_frozen false
 addUserKnob {7 frozen_depth l "Frozen Depth" R 0 1}
 frozen_depth 0
 addUserKnob {26 divider2 l "" +STARTLINE T "Shape"}
 addUserKnob {7 areaWidth l Width R 0.01 2}
 areaWidth 0.3
 addUserKnob {7 areaHeight l Height R 0.01 2}
 areaHeight 0.3
 addUserKnob {7 depth_radius l "Depth Radius" R 0 20}
 depth_radius 5
 addUserKnob {7 light_height l "Light Height" R 0.001 2}
 light_height 0.1
 addUserKnob {26 divider3 l "" +STARTLINE T Falloff}
 addUserKnob {7 lightDecay l Decay R 0 4}
 lightDecay 2
 addUserKnob {7 softness l Softness R 0 1}
 softness 0.5
 addUserKnob {26 divider4 l "" +STARTLINE T Blending}
 addUserKnob {7 original_mix l "Original Light"}
 addUserKnob {7 wrap l Wrap}
 wrap 0.2
 addUserKnob {26 divider5 l "" +STARTLINE T "Output"}
 addUserKnob {6 light_only l "Light only (no albedo)" +STARTLINE}
 light_only false
}
 Input {
  inputs 0
  name PBR
  xpos 300
  ypos 0
 }
 Dot {
  name Dot1
  xpos 334
  ypos 40
 }
set Nin [stack 0]
add_layer {Basecolor Basecolor.red Basecolor.green Basecolor.blue}
 Shuffle2 {
  fromInput1 {{0} B}
  in1 Basecolor
  out1 rgb
  fromInput2 {{0} B}
  mappings "3 Basecolor.red 0 0 rgba.red 0 0 Basecolor.green 0 1 rgba.green 0 1 Basecolor.blue 0 2 rgba.blue 0 2"
  name SBase
  xpos 0
  ypos 100
 }
set vBase [stack 0]
push $Nin
add_layer {Normal Normal.red Normal.green Normal.blue}
 Shuffle2 {
  fromInput1 {{0} B}
  in1 Normal
  out1 rgb
  fromInput2 {{0} B}
  mappings "3 Normal.red 0 0 rgba.red 0 0 Normal.green 0 1 rgba.green 0 1 Normal.blue 0 2 rgba.blue 0 2"
  name SNorm
  xpos 120
  ypos 100
 }
set vNorm [stack 0]
push $Nin
add_layer {Irradiance Irradiance.red Irradiance.green Irradiance.blue}
 Shuffle2 {
  fromInput1 {{0} B}
  in1 Irradiance
  out1 rgb
  fromInput2 {{0} B}
  mappings "3 Irradiance.red 0 0 rgba.red 0 0 Irradiance.green 0 1 rgba.green 0 1 Irradiance.blue 0 2 rgba.blue 0 2"
  name SIrr
  xpos 240
  ypos 100
 }
set vIrr [stack 0]
push $Nin
add_layer {Roughness Roughness.red Roughness.green Roughness.blue}
 Shuffle2 {
  fromInput1 {{0} B}
  in1 Roughness
  out1 rgb
  fromInput2 {{0} B}
  mappings "3 Roughness.red 0 0 rgba.red 0 0 Roughness.green 0 1 rgba.green 0 1 Roughness.blue 0 2 rgba.blue 0 2"
  name SRough
  xpos 360
  ypos 100
 }
set vRough [stack 0]
push $Nin
add_layer {Metallic Metallic.red Metallic.green Metallic.blue}
 Shuffle2 {
  fromInput1 {{0} B}
  in1 Metallic
  out1 rgb
  fromInput2 {{0} B}
  mappings "3 Metallic.red 0 0 rgba.red 0 0 Metallic.green 0 1 rgba.green 0 1 Metallic.blue 0 2 rgba.blue 0 2"
  name SMetal
  xpos 480
  ypos 100
 }
set vMetal [stack 0]
push $Nin
add_layer {Specular Specular.red Specular.green Specular.blue}
 Shuffle2 {
  fromInput1 {{0} B}
  in1 Specular
  out1 rgb
  fromInput2 {{0} B}
  mappings "3 Specular.red 0 0 rgba.red 0 0 Specular.green 0 1 rgba.green 0 1 Specular.blue 0 2 rgba.blue 0 2"
  name SSpec
  xpos 600
  ypos 100
 }
set vSpec [stack 0]
push $Nin
add_layer {Depth Depth.red Depth.green Depth.blue}
 Shuffle2 {
  fromInput1 {{0} B}
  in1 Depth
  out1 rgb
  fromInput2 {{0} B}
  mappings "3 Depth.red 0 0 rgba.red 0 0 Depth.green 0 1 rgba.green 0 1 Depth.blue 0 2 rgba.blue 0 2"
  name SDepth
  xpos 720
  ypos 100
 }
set vDepth [stack 0]

 push $vDepth
 push $vSpec
 push $vMetal
 push $vRough
 push $vIrr
 push $vNorm
 push $vBase
 BlinkScript {
  inputs 7
  recompileCount 1
  ProgramGroup 1
  kernelSource "kernel GGXAreaLight : ImageComputationKernel<ePixelWise>\n\{\n    Image<eRead, eAccessPoint, eEdgeClamped> baseImg;\n    Image<eRead, eAccessPoint, eEdgeClamped> normalImg;\n    Image<eRead, eAccessPoint, eEdgeClamped> irradImg;\n    Image<eRead, eAccessPoint, eEdgeClamped> roughImg;\n    Image<eRead, eAccessPoint, eEdgeClamped> metalImg;\n    Image<eRead, eAccessPoint, eEdgeClamped> specImg;\n    Image<eRead, eAccessRandom, eEdgeClamped> depthImg;\n    Image<eWrite, eAccessPoint> outImg;\n\n    param:\n        float2 anchorUV;\n        float  offsetZ;\n        float  useFrozen;\n        float  frozenDepth;\n        float  areaW;\n        float  areaH;\n        float  depthRadius;\n        float  lightHeight;\n        float  decay;\n        float  softAmount;\n        float3 lightColor;\n        float  intensity;\n        float  originalMix;\n        float  wrapAmount;\n        float  lightOnly;\n\n    local:\n        int2 imgSize;\n\n    void define()\n    \{\n        defineParam(anchorUV,    \"anchorUV\",    float2(0.5f, 0.5f));\n        defineParam(offsetZ,     \"offsetZ\",     0.0f);\n        defineParam(useFrozen,   \"useFrozen\",   0.0f);\n        defineParam(frozenDepth, \"frozenDepth\", 0.0f);\n        defineParam(areaW,       \"areaW\",       0.3f);\n        defineParam(areaH,       \"areaH\",       0.3f);\n        defineParam(depthRadius, \"depthRadius\", 5.0f);\n        defineParam(lightHeight, \"lightHeight\", 0.1f);\n        defineParam(decay,       \"decay\",       2.0f);\n        defineParam(softAmount,  \"softAmount\",  0.5f);\n        defineParam(lightColor,  \"lightColor\",  float3(1.0f, 1.0f, 1.0f));\n        defineParam(intensity,   \"intensity\",   1.0f);\n        defineParam(originalMix, \"originalMix\", 0.0f);\n        defineParam(wrapAmount,  \"wrapAmount\",  0.2f);\n        defineParam(lightOnly,   \"lightOnly\",   0.0f);\n    \}\n\n    void init()\n    \{\n        imgSize = outImg.bounds.size();\n    \}\n\n    void process(int2 pos)\n    \{\n        float pi = 3.14159265358979f;\n\n        float sx = float(pos.x) / float(imgSize.x);\n        float sy = float(pos.y) / float(imgSize.y);\n\n        int hx = int(anchorUV.x * float(imgSize.x));\n        int hy = int(anchorUV.y * float(imgSize.y));\n        hx = max(0, min(hx, imgSize.x - 1));\n        hy = max(0, min(hy, imgSize.y - 1));\n        float depthA;\n        if (useFrozen > 0.5f) depthA = frozenDepth;\n        else depthA = depthImg(hx, hy).x;\n        float lightZ = depthA + offsetZ;\n        float depthP = depthImg(pos.x, pos.y).x;\n\n        float dx = anchorUV.x - sx;\n        float dy = anchorUV.y - sy;\n        float dz = lightZ - depthP;\n\n        float hw = max(areaW, 0.0001f);\n        float hh = max(areaH, 0.0001f);\n        float rz = max(depthRadius * 0.1f, 0.0001f);\n        float inner = clamp(1.0f - softAmount, 0.0f, 1.0f);\n        float invInner = max(1.0f - inner, 0.0001f);\n\n        float axx = max(dx, -dx) / hw;\n        float ayy = max(dy, -dy) / hh;\n        float r2d = max(axx, ayy);\n        float x2 = clamp((r2d - inner) / invInner, 0.0f, 1.0f);\n        float s2 = x2 * x2 * (3.0f - 2.0f * x2);\n        float rectFall = pow(1.0f - s2, decay);\n\n        float azz = max(dz, -dz) / rz;\n        float dt = clamp(azz, 0.0f, 1.0f);\n        float dx2 = clamp((dt - inner) / invInner, 0.0f, 1.0f);\n        float ds2 = dx2 * dx2 * (3.0f - 2.0f * dx2);\n        float depthFall = 1.0f - ds2;\n\n        float atten = rectFall * depthFall;\n\n        float3 toLight = float3(dx, dy, lightHeight);\n        float3 L = normalize(toLight);\n        float3 V = float3(0.0f, 0.0f, 1.0f);\n        float3 Hh = normalize(L + V);\n\n        float3 N = normalImg().xyz;\n        N = N * 2.0f - 1.0f;\n        N = normalize(N);\n\n        float NdotL = max(dot(N, L), 0.0f);\n        float NdotV = max(dot(N, V), 0.0001f);\n        float NdotH = max(dot(N, Hh), 0.0f);\n        float VdotH = max(dot(V, Hh), 0.0f);\n\n        float rough = clamp(roughImg().x, 0.03f, 1.0f);\n        float a  = rough * rough;\n        float a2 = a * a;\n        float metal = clamp(metalImg().x, 0.0f, 1.0f);\n        float specv = clamp(specImg().x, 0.0f, 1.0f);\n        float3 albedo = baseImg().xyz;\n\n        if (lightOnly > 0.5f)\n        \{\n            albedo = float3(1.0f, 1.0f, 1.0f);\n            metal = 0.0f;\n        \}\n\n        float f0d = 0.08f * specv;\n        float3 F0;\n        F0.x = f0d * (1.0f - metal) + albedo.x * metal;\n        F0.y = f0d * (1.0f - metal) + albedo.y * metal;\n        F0.z = f0d * (1.0f - metal) + albedo.z * metal;\n\n        float denom = NdotH * NdotH * (a2 - 1.0f) + 1.0f;\n        float D = a2 / (pi * denom * denom + 0.0001f);\n\n        float k = a * 0.5f;\n        float gv = NdotV / (NdotV * (1.0f - k) + k);\n        float gl = NdotL / (NdotL * (1.0f - k) + k);\n        float G = gv * gl;\n\n        float fc = pow(1.0f - VdotH, 5.0f);\n        float3 F;\n        F.x = F0.x + (1.0f - F0.x) * fc;\n        F.y = F0.y + (1.0f - F0.y) * fc;\n        F.z = F0.z + (1.0f - F0.z) * fc;\n\n        float sd = 4.0f * NdotL * NdotV + 0.0001f;\n        float3 spec;\n        spec.x = D * G * F.x / sd;\n        spec.y = D * G * F.y / sd;\n        spec.z = D * G * F.z / sd;\n\n        float3 diff;\n        diff.x = (1.0f - F.x) * (1.0f - metal) * albedo.x / pi;\n        diff.y = (1.0f - F.y) * (1.0f - metal) * albedo.y / pi;\n        diff.z = (1.0f - F.z) * (1.0f - metal) * albedo.z / pi;\n\n        float wrapNL = clamp((dot(N, L) + wrapAmount) / (1.0f + wrapAmount), 0.0f, 1.0f);\n\n        float3 rad;\n        rad.x = lightColor.x * intensity;\n        rad.y = lightColor.y * intensity;\n        rad.z = lightColor.z * intensity;\n\n        float3 newTerm;\n        newTerm.x = (diff.x * wrapNL + spec.x * NdotL) * atten * rad.x;\n        newTerm.y = (diff.y * wrapNL + spec.y * NdotL) * atten * rad.y;\n        newTerm.z = (diff.z * wrapNL + spec.z * NdotL) * atten * rad.z;\n\n        float omix = originalMix;\n        if (lightOnly > 0.5f) omix = 0.0f;\n\n        float3 irrad = irradImg().xyz;\n        float3 orig;\n        orig.x = baseImg().x * irrad.x;\n        orig.y = baseImg().y * irrad.y;\n        orig.z = baseImg().z * irrad.z;\n\n        float3 result;\n        result.x = newTerm.x * (1.0f - omix) + orig.x * omix;\n        result.y = newTerm.y * (1.0f - omix) + orig.y * omix;\n        result.z = newTerm.z * (1.0f - omix) + orig.z * omix;\n\n        outImg() = float4(result.x, result.y, result.z, 1.0f);\n    \}\n\};\n"
  rebuild ""
  GGXAreaLight_anchorUV {{"parent.light_pos.x / PBR.width"} {"parent.light_pos.y / PBR.height"}}
  GGXAreaLight_offsetZ {{parent.offset_z}}
  GGXAreaLight_useFrozen {{parent.use_frozen}}
  GGXAreaLight_frozenDepth {{parent.frozen_depth}}
  GGXAreaLight_areaW {{parent.areaWidth}}
  GGXAreaLight_areaH {{parent.areaHeight}}
  GGXAreaLight_depthRadius {{parent.depth_radius}}
  GGXAreaLight_lightHeight {{parent.light_height}}
  GGXAreaLight_decay {{parent.lightDecay}}
  GGXAreaLight_softAmount {{parent.softness}}
  GGXAreaLight_lightColor {{parent.lightColor.r} {parent.lightColor.g} {parent.lightColor.b}}
  GGXAreaLight_intensity {{parent.lightIntensity}}
  GGXAreaLight_originalMix {{parent.original_mix}}
  GGXAreaLight_wrapAmount {{parent.wrap}}
  GGXAreaLight_lightOnly {{parent.light_only}}
  rebuild_finalise ""
  name AreaLightBlink
  xpos 300
  ypos 280
 }
 Output {
  name Output1
  xpos 300
  ypos 380
 }
end_group
